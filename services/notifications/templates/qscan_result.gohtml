{{- /*gotype: github.com/bcc-code/bcc-media-flows/services/notifications.QScanResult */ -}}
{{template "header" .}}
                            <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 20px;">
                                <tr>
                                    {{if .Passed}}
                                    <td style="background-color:#e3f6ec; color:#0b6b3a; font-size:13px; font-weight:600; padding:6px 14px; border-radius:14px;">&#10003; {{.Outcome.Value}}</td>
                                    {{else}}
                                    <td style="background-color:#fde8e8; color:#9b1c1c; font-size:13px; font-weight:600; padding:6px 14px; border-radius:14px;">&#10007; {{.Outcome.Value}}</td>
                                    {{end}}
                                </tr>
                            </table>

                            {{if .Error}}
                            <p style="margin:0 0 16px; font-size:15px; line-height:1.5;">The QC run did not complete.</p>
                            <pre style="margin:0 0 16px; padding:12px; background-color:#f4f5f7; border-radius:6px; font-size:12px; white-space:pre-wrap;">{{.Error}}</pre>
                            {{else}}
                            <p style="margin:0 0 16px; font-size:15px; line-height:1.5;">
                                QScan has analysed the uploaded master.{{if .ReportNote}} {{.ReportNote}}{{else}} The full report is attached.{{end}}
                            </p>
                            {{end}}

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                <tr>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#7b8794; width:40%;">VX-ID</td>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:14px; color:#1f2933;">{{.VXID}}</td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#7b8794;">File</td>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:14px; color:#1f2933;">{{.Filename}}</td>
                                </tr>
                                {{if .Status}}
                                <tr>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#7b8794;">QScan status</td>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:14px; color:#1f2933;">{{.Status}}{{if .StatusInfo}} ({{.StatusInfo}}){{end}}</td>
                                </tr>
                                {{end}}
                                {{if not .Error}}
                                <tr>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#7b8794;">Critical / Warning / Logging</td>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:14px; color:#1f2933;">{{.Critical}} / {{.Warning}} / {{.Logging}}</td>
                                </tr>
                                {{end}}
                                {{if .JobName}}
                                <tr>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#7b8794;">QScan job</td>
                                    <td style="padding:10px 0; border-bottom:1px solid #edf0f3; font-size:14px; color:#1f2933;">{{if .QScanURL}}<a href="{{.QScanURL}}" style="color:#1f3a5f;">{{.JobName}}</a>{{else}}{{.JobName}}{{end}}</td>
                                </tr>
                                {{end}}
                            </table>

                            {{if .Events}}
                            <p style="margin:24px 0 8px; font-size:13px; color:#7b8794; text-transform:uppercase; letter-spacing:0.06em;">Events ({{len .Events}} of {{.TotalEvents}})</p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                <tr>
                                    <th align="left" style="padding:8px 0; border-bottom:2px solid #edf0f3; font-size:12px; color:#7b8794; text-transform:uppercase; letter-spacing:0.06em;">Severity</th>
                                    <th align="left" style="padding:8px 0; border-bottom:2px solid #edf0f3; font-size:12px; color:#7b8794; text-transform:uppercase; letter-spacing:0.06em;">Type</th>
                                    <th align="left" style="padding:8px 0; border-bottom:2px solid #edf0f3; font-size:12px; color:#7b8794; text-transform:uppercase; letter-spacing:0.06em;">Message</th>
                                    <th align="left" style="padding:8px 0; border-bottom:2px solid #edf0f3; font-size:12px; color:#7b8794; text-transform:uppercase; letter-spacing:0.06em;">Timecode</th>
                                </tr>
                                {{range .Events}}
                                <tr>
                                    <td style="padding:8px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#1f2933;">{{.Severity}}</td>
                                    <td style="padding:8px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#1f2933;">{{.MediaType}}</td>
                                    <td style="padding:8px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#1f2933;">{{.Message}}</td>
                                    <td style="padding:8px 0; border-bottom:1px solid #edf0f3; font-size:13px; color:#1f2933; white-space:nowrap;">{{.TCIn}}{{if and .TCOut (ne .TCOut .TCIn)}} &ndash; {{.TCOut}}{{end}}</td>
                                </tr>
                                {{end}}
                            </table>
                            {{end}}
{{template "footer" .}}
