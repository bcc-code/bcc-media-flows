# Temporal configuration. Host and port, not a URL: client.Dial wants host:port.
TEMPORAL_HOST_PORT=temporal.lan.bcc.media:7233
TEMPORAL_NAMESPACE=default

# Identity of the worker to be identified in temporal
IDENTITY=worker01

# How many activities to run in parallel
ACTIVITY_COUNT=5

# Rudderstack configuration
RUDDERSTACK_WRITE_KEY=
RUDDERSTACK_DATA_PLANE_URL=

# ClickUp (Shorts Export) — read-only via the public share view, no API key.
# All of these have hardcoded defaults for the public Shorts Export view
# (see services/clickup/client.go); set them only to override. The token is the
# public-share token from the view's "Share" URL.
# CLICKUP_FRONTDOOR_BASE_URL=https://frontdoor-prod-eu-west-1-3.clickup.com
# CLICKUP_WORKSPACE_ID=9004075864
# CLICKUP_SHORTS_VIEW_ID=8cayjur-533995
# CLICKUP_SHORTS_VIEW_TOKEN=ddef98b0bd69a81

# Vidispine
VIDISPINE_BASE_URL=http://10.12.128.15:8080/API
VIDISPINE_USERNAME=
VIDISPINE_PASSWORD=

# Cantemo
CANTEMO_URL=
CANTEMO_TOKEN=

# Subtrans
SUBTRANS_BASE_URL=
SUBTRANS_API_KEY=

# Directus
DIRECTUS_BASE_URL=
DIRECTUS_API_KEY=

# rclone
RCLONE_USERNAME=
RCLONE_PASSWORD=

# FileCatalyst
FILECATALYST_URL=
FILECATALYST_USERNAME=
FILECATALYST_PASSWORD=

# Playout FTP
PLAYOUT_FTP_ADDRESS=
PLAYOUT_FTP_USERNAME=
PLAYOUT_FTP_PASSWORD=

# Notifications
TELEGRAM_BOT_TOKEN=
SENDGRID_API_KEY=
